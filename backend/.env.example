# ShikshaSetu AI Backend Configuration

# API Keys
# The API key for Google Gemini (required for embeddings and generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Database
# PostgreSQL connection string (must have pgvector enabled)
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/shikshasetu

# Model Settings
# Which Gemini models to use
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_GENERATION_MODEL=gemini-3.6-flash

# Security
JWT_SECRET_KEY=your_secure_jwt_secret_key_here

# Environment
ENVIRONMENT=development
DEBUG=true

# CORS Configuration
# Set to the URL of the frontend application (e.g. http://localhost:3000)
FRONTEND_URL=http://localhost:3000
# Optional: comma-separated list of additional allowed origins
CORS_ORIGINS=
